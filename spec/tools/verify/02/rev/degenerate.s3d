arc a0 r=5 angle=30,30
helix h0 r=5 pitch=0 turns=1
spline s2 closed=true path=[(0,0,0); (3,0,0)]
revolve neg profile=[(0,0); (3,1); (0,2)] smooth=true at=20,0,0
revolve ang profile=[(0,0); (2,0); (2,3); (0,3)] angle=500 at=40,0,0
cyl z0 r=0 h=2 at=60,0,0
cone k00 r=0 r2=0 h=2 at=70,0,0
span st from=(0,0,0) to=(0,5,0) steps=4 section=1,0.2
span sr from=(0,0,-20) to=(0,5,-20) steps=2.4 section=1,0.2
sweep sw path=[(0,0,-40); (0,0,-40); (5,0,-40)] section=1,0.2
line dup path=[(0,0,-50); (0,0,-50); (5,0,-50)]
box md size=0.1,0.1,0.1 at=dup.mid pin=center
sweep sx path=[(0,0,-70); (5,0,-70); (5,0,-65)] profile=circle section=3,1 r=0.2
