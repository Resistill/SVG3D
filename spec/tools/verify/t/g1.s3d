box ground size=40,1,40 pin=top
box a size=1,3,1 on=ground
box b size=1,1,1 on=ground[0.3,1,0] #cargo
material steel color=#7f8b96
concept tall = all() where h > 2
over all() where h > 2 size=2,2,2
over tall mat=steel size=1,1,1
over on(ground) size=1,1,1
over kind(box) where name ~ /^a/ color=#ff0000 size=1,1,1
over #nothing color=#00ff00
over nothing color=#00ff00
over tall color=#0000ff
over on(ground) color=#123456
over b mat=steel
