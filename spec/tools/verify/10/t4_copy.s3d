material a color=#111111 metal=0.6 rough=0.4
material b color=#222222
material rust color=#8a4a2a rough=0.9
box floor size=40,1,40 pin=top
group tower mat=a on=floor { box leg size=0.6,4,0.6; box top size=2,1,2 on=leg color=#00ff00 }
mirror tower2 of=tower across=x mat=rust
box pole size=1,3,1 on=floor at=5,0,0 mat=a
mirror pole2 of=pole across=z mat=rust
group G mat=rust on=floor at=-5,0,0 { mirror tower3 of=tower across=z }
mirror tower4 of=tower across=x color=#0000ff
