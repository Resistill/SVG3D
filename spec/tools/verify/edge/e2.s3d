box floor size=40,1,24 pin=top
box w1 #wall size=1,3,1 at=5,0,5
group g on=floor { group h { box a size=1,1,1 on=#wall } box b size=1,1,1 }
group g2 at=0,0,-10 pin=origin { group h2 at=1,0,0 { box a2 size=1,1,1 on=#wall } }
group g3 on=floor { group h3 on=floor { box a3 size=1,1,1 on=#wall } }
group g4 on=floor { box x size=1,1,1 on=y; box y size=1,1,1 on=x; box z size=1,1,1 }
repeat r0 n=0 step=1,0,0 { box i size=1,1,1 }
repeat r1 n=2.4 step=1,0,0 { box i size=1,1,1 }
repeat r2 n=-1 step=1,0,0 { box i size=1,1,1 }
repeat r3 n=3 step=1,0,0 turn=10 { box i size=1,1,1 }
repeat r4 n=(2,2) step=1,2,3 center=true { box i size=1,1,1 }
arc c r=5
repeat r5 n=4 along=c { box i size=0.5,0.5,0.5 }
repeat r6 n=3 along=c orient=none turn=15 { box i size=0.5,0.5,0.5 }
rotate rr n=2 about=floor.right { box s size=1,1,1 at=3,0,0 }
