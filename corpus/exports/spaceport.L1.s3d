// 由逆向管线从 spaceport.L1.glb 生成（L1）。~fit 是拟合度，~err 是相对误差；mesh 是拟合不了、直接引用源网格的部件

material steel color=#7f8b96 metal=0.6 rough=0.4
material white color=#eceef0 metal=0.05 rough=0.78
material hazard color=#e0a92e metal=0.05 rough=0.78
material asphalt color=#3b3d40 metal=0.05 rough=1
material concrete color=#b8b4aa metal=0.05 rough=0.78
material ground color=#59604f metal=0.05 rough=1
material earth color=#8a7a58 metal=0.05 rough=1

box terrain size=200,1,200 at=0,-1,0 mat=ground ~fit=1 ~src="part_0080"
cyl tank_1 r=2.4 h=20 axis=x on=terrain[-0.45,1,-0.2] mat=white ~fit=0.9227 ~src="part_0029"
mesh volume_1 src="spaceport.L1.glb#part_0041" size=34,22,26 pivot=-45,0,-20 on=terrain[-0.45,1,-0.2] mat=concrete ~fit=0 ~src="part_0041"
repeat tanks n=3 step=10,0,0 on=terrain[0.2,1,0.55] pin=origin {
  cyl tank r=3.5 h=9 mat=white ~fit=0.9344
  sphere volume r=3.5 at=tank[0,0.222222,0] mat=white ~fit=0.9239
  cyl slab r=3.6 h=0.6 at=tank[0,0.333333,0] mat=hazard ~fit=0.8243
}
box platform_1 size=26,2,26 on=terrain[0.25,1,0] mat=concrete ~fit=1 ~src="part_0043"
box volume_2 size=14,8,12 on=terrain[-0.68,1,-0.26] turn=-90 mat=concrete ~fit=1 ~src="part_0056"
mirror volume_3 of=volume_2 across=tank_1 axis=x
box volume_4 size=14,5,10 on=terrain[-0.05,1,0.55] turn=30 mat=concrete ~fit=1 ~src="part_0072"
wedge volume_5 size=7,5,10 on=terrain[-0.140933,1,0.6025] turn=30 mat=earth ~fit=1 ~src="part_0087"
repeat columns_1 n=(2,1,2) step=40,0,40 on=terrain[0.05,1,-0.2] pin=origin {
  cyl column r=0.4 h=30 mat=steel ~fit=0.9086
  box prop size=2.4,1.2,2.4 on=column mat=white ~fit=1
}
mesh platform_2 src="spaceport.L1.glb#part_0034" size=56.5285,0.08,19.8905 pivot=-19.0281,0,6.8184 on=terrain[-0.190281,1,0.068184] mat=asphalt ~fit=0 ~src="part_0034"
repeat steps n=24 step=0,0.2713,0 turn=15.6521 on=terrain[-0.179928,1,0.5] pin=origin {
  box step size=2,0.12,0.7 at=1.2,0,0 mat=steel ~fit=0.9999
}
cyl column_1 r=0.35 h=6.5 on=steps.0.step[-1.200001,1,0] mat=steel ~fit=0.9126 ~src="part_0050"
mesh mesh_1 src="spaceport.L1.glb#part_0045" size=2.4,7.75,12 pivot=-22,0.25,-13 at=volume_3[1.857143,-0.9375,0] mat=steel ~fit=0 ~src="part_0045"
mirror mesh_2 of=mesh_1 across=tank_1 axis=x
mesh slab_1 src="spaceport.L1.glb#part_0078" size=11.7,1.75,38.507 pivot=34.5,1,32.2492 at=platform_1[0.73077,0,2.480709] mat=steel ~fit=0 ~src="part_0078"
mesh beam src="spaceport.L1.glb#part_0074" size=1.7,1.75,38.5009 pivot=20.5,1,32.2499 at=platform_1[-0.346154,0,2.480761] mat=steel ~fit=0 ~src="part_0074"
mesh volume_6 src="spaceport.L1.glb#part_0075" size=4.3,6.3304,4.2974 pivot=-17.9928,1.0748,50 at=column_1[0.000001,-0.706215,0] mat=steel ~fit=0 ~src="part_0075"
cyl tank_2 r=2.4 h=28 on=platform_1 mat=white ~fit=0.9159 ~src="part_0006"
repeat columns_2 n=(2,1,2) step=6,0,6 on=platform_1[0.469231,1,-0.930769] pin=origin {
  box column size=0.6,48,0.6 mat=steel ~fit=1
}
mirror columns_3 of=columns_2 across=tank_2 axis=x
rotate walls n=3 angle=90 about=platform_1 {
  wedge wall size=3.5,6,0.4 on=platform_1[0,1,0.319231] turn=90 mat=hazard ~fit=1
}
repeat slabs_1 n=8 step=0,6,0 at=columns_2.3.column[-9.999994,-0.766667,-10.000009] pin=origin {
  box slab size=7.2,0.4,7.2 mat=steel ~fit=1
  cyl member r=0.15 h=7.9398 axis=x at=slab[-0.027297,-14.566918,0.833333] rot=(0.349511,0.936932,0.000002,179.99953) mat=steel ~fit=0.1678
}
mirror slabs_2 of=slabs_1 across=tank_2 axis=x
cyl column_2 r=0.25 h=7 on=volume_4[0.6,1,0] mat=steel ~fit=0.912 ~src="part_0103"
mesh mesh_3 src="spaceport.L1.glb#part_0047" size=11.0036,14.26,2.02 pivot=-21.5,8.54,-26.01 at=-21.5,8.54,-26.01 mat=steel ~fit=0 ~src="part_0047"
mirror mesh_4 of=mesh_3 across=tank_1 axis=x
sphere volume_7 r=1.6 on=column_2 mat=white ~fit=0.9239 ~src="part_0094"
box platform_3 size=36,0.8,28 on=volume_1 mat=steel ~fit=1 ~src="part_0099"
cyl platform_4 r=2.45 h=0.8 at=tank_2[0,0.942857,0] mat=hazard ~fit=0.8469 ~src="part_0069"
cyl tank_3 r=2 h=14 on=tank_2 mat=white ~fit=0.9211 ~src="part_0011"
box slab_2 size=6.0812,0.3,1.6 at=tank_3[-1.675,0.141429,-1.675] rot=(0.001644,-0.999991,-0.00397,45.00038) mat=steel ~fit=1 ~src="part_0030"
mirror slab_3 of=slab_2 across=tank_2 axis=x
mesh volume_8 src="spaceport.L1.glb#part_0042" size=4,7,4 pivot=25,44,0 on=tank_3 mat=white ~fit=0 ~src="part_0042"
