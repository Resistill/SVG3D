box ground size=200,1,200 at=0,-1,0 mat=ground ~fit=1 ~src="ground" ~role="terrain"
cyl spare r=2.4 h=20 axis=x on=ground[-0.45,1,-0.2] mat=white ~fit=0.9202 ~src="spare"
