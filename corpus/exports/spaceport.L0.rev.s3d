// 由逆向管线从 spaceport.L0.glb 生成（L0）。~fit 是拟合度，~err 是相对误差；mesh 是拟合不了、直接引用源网格的部件

material ground color=#59604f metal=0.05 rough=1
material concrete color=#b8b4aa metal=0.05 rough=0.78
material white color=#eceef0 metal=0.05 rough=0.78
material hazard color=#e0a92e metal=0.05 rough=0.78
material steel color=#7f8b96 metal=0.6 rough=0.4 default=true
material asphalt color=#3b3d40 metal=0.05 rough=1
material earth color=#8a7a58 metal=0.05 rough=1

box ground size=200,1,200 at=0,-1,0 mat=ground ~fit=1 ~src="ground" ~role="terrain"
cyl spare r=2.4 h=20 axis=x on=ground[-0.45,1,-0.2] mat=white ~fit=0.9239 ~src="spare"
subtract hangar_body on=ground[-0.45,1,-0.2] mat=concrete ~fit=0.96 ~src="hangar.body" {
  box outer size=34,22,26
  box cavity size=32.4,22,24.4 at=0,-0.8,0
  box opening size=11.9,15.4154,2.4 at=0,0,12.6
  cyl arch r=5.95 h=2.4 axis=z at=0,9.4654,12.6
}
repeat tanks n=3 step=10,0,0 on=ground[0.2,1,0.55] pin=origin {
  cyl tank r=3.5 h=9 mat=white ~fit=0.9308
  sphere cap r=3.5 at=tank offset=0,1,0 mat=white ~fit=0.9206
  cyl ring r=3.6 h=0.6 at=tank offset=0,1.5,0 mat=hazard ~fit=0.8362
}
box pad size=26,2,26 on=ground[0.25,1,0] mat=concrete ~fit=1 ~src="pad"
box wings_annex size=14,8,12 on=ground[-0.22,1,-0.26] turn=-90 mat=concrete ~fit=1 ~src="wings.annex"
mirror wings_mirrored_annex of=wings_annex across=hangar_roof axis=x
pipe feed2 path=[(39.9948,1.349,51.4705); (39.8801,1.3588,47.7872); (39.5231,1.3887,44.1198); (38.878,1.4679,40.4938); (37.8942,1.5538,36.9445); (36.5868,1.6686,33.5019); (34.9911,1.8272,30.1843); (33.2469,2.0035,26.942); (31.5452,2.1584,23.6773); (30.1423,2.2905,20.2742); (29.2843,2.3748,16.6952); (28.9792,2.4003,13.0247)] r=0.3473 smooth=true ~fit=0.2334 ~src="feed2"
box bunker size=14,5,10 on=ground[-0.05,1,0.55] turn=30 mat=concrete ~fit=1 ~src="bunker"
wedge berm size=7,5,10 on=ground offset=-14.09,0,60.25 turn=30.000001 mat=earth ~fit=1 ~src="berm"
span wings_stair2 from=-16,8,-26 to=-27,22.8,-26.02 steps=20 section=2.002,0.2 ~fit=0.9869 ~src="wings.stair2"
mirror wings_mirrored_stair2 of=wings_stair2 across=hangar_roof axis=x
span wings_stair1 from=-22,0,-7 to=-22,8,-19 steps=16 section=2.4,0.25 ~fit=1 ~src="wings.stair1"
mirror wings_mirrored_stair1 of=wings_stair1 across=hangar_roof axis=x
helix spiral_rail_path r=2.0989 pitch=6.234 turns=1 at=-17.9936,1.1204,49.9997 pin=origin turn=-0.169491
sweep spiral_rail path=spiral_rail_path r=0.0495 ~fit=0.8464 ~src="spiral.rail"
pipe feed1 path=[(20.994,2.3981,13.0303); (20.9205,2.312,19.4337); (20.67,2.0554,25.8288); (20.3581,1.7332,32.2182); (20.1447,1.4983,38.6153); (20.0302,1.3874,45.018); (20.0063,1.3402,51.4231)] r=0.3468 smooth=true ~fit=0.4451 ~src="feed1"
repeat lights n=(2,1,2) step=40,0,40 on=ground[0.05,1,-0.2] pin=origin {
  cyl pole r=0.4 h=30 ~fit=0.9079
  box lamp size=2.4,1.2,2.4 on=pole mat=white ~role="decor" ~fit=1
}
arc road_path r=47.139 angle=-53.545254,-122.52677 at=-20.2892,0.04,-35.9448 pin=origin
sweep road path=road_path section=10.9142,0.08 mat=asphalt ~fit=0.8739 ~src="road" ~role="terrain"
repeat spiral_treads n=24 step=0,0.2713,0 turn=15.65214 on=ground[-0.17993,1,0.5] pin=origin {
  box tread size=2,0.12,0.7 at=1.2,0,0 ~fit=0.9999
}
cyl spiral_core r=0.35 h=6.5 on=spiral_treads.0.tread[-1.2,1,0] ~fit=0.9139 ~src="spiral.core"
cyl rocket_stage1 r=2.4 h=28 on=pad mat=white ~fit=0.9189 ~src="rocket.stage1"
repeat tower_legs n=(2,1,2) step=6,0,6 on=pad offset=-12.1,0,-12.1 pin=origin {
  box leg size=0.6,48,0.6 ~fit=1
}
mirror tower2_legs of=tower_legs across=pad axis=x
