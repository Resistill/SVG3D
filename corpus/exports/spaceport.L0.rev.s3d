}
mirror tower2_decks of=tower_decks across=pad axis=x
cyl mast r=0.25 h=7 on=bunker[0.6,1,0] ~fit=0.9136 ~src="mast"
sphere radome r=1.6 on=mast mat=white ~fit=0.9233 ~src="radome"
box hangar_roof size=36,0.8,28 on=hangar_body ~fit=1 ~src="hangar.roof"
cyl rocket_band r=2.45 h=0.8 at=rocket_stage1 offset=0,13.2,0 mat=hazard ~fit=0.8579 ~src="rocket.band"
cyl rocket_stage2 r=2 h=14 on=rocket_stage1 mat=white ~fit=0.9196 ~src="rocket.stage2"
box arm size=6.0812,0.3,1.6 at=rocket_stage2 offset=-3.35,0.99,-3.35 rot=(0.001644,-0.999991,-0.00397,45.00038) ~fit=1 ~src="arm"
mirror arm2 of=arm across=pad axis=x
revolve rocket_nose profile=[(2,0); (1.9663,1.6042); (1.9134,2.4792); (1.7156,3.9375); (1.4594,5.1042); (1.1319,5.9792); (0.9809,6.2708); (0.5889,6.8542); (0.2109,7)] on=rocket_stage2 mat=white ~fit=0.4307 ~src="rocket.nose"
