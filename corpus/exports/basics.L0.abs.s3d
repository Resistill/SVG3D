// 由逆向管线从 basics.L0.glb 生成（L0）。~fit 是拟合度，~err 是相对误差；mesh 是拟合不了、直接引用源网格的部件

material a color=#d9d4c7 metal=0.05 rough=0.78
material c color=#4f8fc0 metal=0.05 rough=0.78
material b color=#e07a3a metal=0.05 rough=0.78
material d color=#7aa35a metal=0.05 rough=0.78

box floor size=40,1,24 at=0,-1,0 mat=a ~fit=1 ~src="floor"
box table size=8,3,5 at=-10,0,0 mat=c ~fit=1 ~src="table" ~role="decor"
cyl cup r=0.6 h=1.2 at=-10,3,0 mat=b ~fit=0.94 ~src="cup" ~role="decor"
sphere ball r=0.8 at=-7.6,3,-1.25 mat=d ~fit=0.9231 ~src="ball"
box shelf size=10,9,2 at=0,0,-11 mat=c ~fit=1 ~src="shelf" ~role="decor"
box book1 size=1.6,3,0.6 at=-4.7,0,-9.2 turn=-90 mat=b ~fit=1 ~src="book1" ~role="decor"
box book2 size=1.6,2.6,0.6 at=-4.1,0,-9.2 turn=-90 mat=d ~fit=1 ~src="book2" ~role="decor"
subtract crate at=11,0,4.8 mat=a ~fit=1 ~src="crate" ~role="decor" {
  box outer size=5,4,5
  box cavity size=4.4,4,4.4 at=0,0.3,0
}
sphere orb r=1.4 at=11,0.3,4.8 mat=b ~fit=0.926 ~src="orb"
box pillarL size=1,7,1 at=6,0,-7.2 mat=c ~fit=1 ~src="pillarL"
box pillarR size=1,7,1 at=17,0,-7.2 mat=c ~fit=1 ~src="pillarR"
box beam size=10,0.6,1 at=11.5,6.4,-7.2 mat=b ~fit=1 ~src="beam"
box ramp size=12.2066,0.2,1.5 at=11.5,3.5,-5.2 rot=(0,0,1,34.99202) mat=d ~fit=1 ~src="ramp"
span stairs from=-20,0,0 to=-14,3,0 steps=8 section=2,0.2 mat=d ~fit=1 ~src="stairs"
box turned size=6,3,3 at=-2,0,6.6 turn=35.000001 mat=c ~fit=1 ~src="turned"
box sticker size=1,1.5,1 at=0.867,0,4.5925 turn=35.000001 mat=b ~fit=1 ~src="sticker" ~role="decal"
